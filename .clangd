# Configuration file for clangd.
# This file is located in the project root, next to CMakeLists.txt.

CompileFlags:
  # Path to the compilation database generated by CMake.
  # clangd uses it to determine:
  # - C++ standard (C++20)
  # - include directories
  # - compiler flags
  # - macro definitions
  CompilationDatabase: build

Diagnostics:
  # Warn about header files that are included but never used.
  # Helps keep dependencies clean and compilation faster.
  UnusedIncludes: Strict

Index:
  # Build and update the project index in the background.
  # Improves navigation, autocomplete and symbol search.
  Background: Build

InlayHints:
  # Display additional inline hints such as deduced types
  # and function parameter names.
  Enabled: Yes